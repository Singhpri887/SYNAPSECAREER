# ============================================================
#  SynapseCareer – Environment Configuration
#  Copy this file to root: d:\New folder (3)\.env
#  Fill in your credentials below
# ============================================================

# ── GMAIL SMTP (Real Email OTP Delivery) ─────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password (select "Mail" > "Windows Computer")
# 4. Paste the 16-character password below (no spaces)

GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASS=xxxxxxxxxxxxxxxxxxxx

# ── FAST2SMS (Real SMS OTP Delivery – Indian Numbers) ─────────
# 1. Register free at: https://www.fast2sms.com
# 2. Go to Dashboard → Dev API → Copy your API Key

FAST2SMS_API_KEY=your_fast2sms_api_key_here
